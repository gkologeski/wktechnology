{
  "manifest_version": 3,
  "name": "TechHire Hunter",
  "version": "1.0.7",
  "description": "Capture perfis completos do LinkedIn (experiência, educação, skills, OpenToWork, atividade) direto pro TechHire ATS.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "https://*.wktechnology.com.br/*"
  ],
  "action": {
    "default_title": "TechHire Hunter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/sales/lead/*"],
      "js": ["messenger.js", "content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lovable.app/auth/extension-link*",
        "https://*.lovableproject.com/auth/extension-link*",
        "https://*.wktechnology.com.br/auth/extension-link*"
      ],
      "js": ["pair-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lovable.app/hunting/install*",
        "https://*.lovableproject.com/hunting/install*",
        "https://*.wktechnology.com.br/hunting/install*",
        "https://*.lovable.app/auth/extension-link*",
        "https://*.lovableproject.com/auth/extension-link*",
        "https://*.wktechnology.com.br/auth/extension-link*"
      ],
      "js": ["status-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
