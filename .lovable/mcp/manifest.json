        "description": "Cria um novo lead no CRM em nome do usuário autenticado, respeitando as permissões do workspace.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
