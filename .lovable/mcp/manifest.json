        "inputSchema": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome do lead."
            },
            "last_name": {
              "type": "string",
              "description": "Sobrenome do lead."
            },
            "email": {
              "type": "string",
